{
  "name": "listoncosmas/liston-legal-webops-core",
  "description": "Portable WordPress application services for the JusticePoint Employment Law demonstration.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "Liston\\LegalWebOps\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Liston\\LegalWebOps\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": "phpcs --standard=phpcs.xml",
    "lint:fix": "phpcbf --standard=phpcs.xml",
    "test": "phpunit --configuration phpunit.xml.dist"
  }
}

